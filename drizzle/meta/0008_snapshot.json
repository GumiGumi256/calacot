      "checkConstraints": {
        "design_purchases_whatsapp_status_check": {
          "name": "design_purchases_whatsapp_status_check",
          "value": "\"design_purchases\".\"whatsapp_status\" in ('not_started', 'message_sent', 'customer_replied', 'advisor_connected', 'closed', 'failed')"
        },
        "design_purchases_purchase_status_check": {
          "name": "design_purchases_purchase_status_check",
          "value": "\"design_purchases\".\"purchase_status\" in ('awaiting_payment', 'awaiting_contact', 'payment_submitted', 'completed', 'cancelled')"
        },
        "design_purchases_contact_check": {
          "name": "design_purchases_contact_check",
          "value": "\"design_purchases\".\"preferred_contact_method\" is null or \"design_purchases\".\"preferred_contact_method\" in ('whatsapp', 'phone', 'email')"
        },
        "design_purchases_includes_check": {
          "name": "design_purchases_includes_check",
          "value": "jsonb_typeof(\"design_purchases\".\"package_includes\") = 'array'"
        },
        "design_purchases_active_check": {
          "name": "design_purchases_active_check",
          "value": "\"design_purchases\".\"access_status\" <> 'active' or (\"design_purchases\".\"payment_status\" = 'confirmed' and \"design_purchases\".\"purchase_status\" = 'completed')"
        },
        "design_purchases_completed_check": {
          "name": "design_purchases_completed_check",
          "value": "\"design_purchases\".\"purchase_status\" <> 'completed' or \"design_purchases\".\"payment_status\" = 'confirmed'"
        },
        "design_purchases_amount_check": {
          "name": "design_purchases_amount_check",
          "value": "\"design_purchases\".\"amount\" > 0"
        },
        "design_purchases_currency_check": {
          "name": "design_purchases_currency_check",
          "value": "\"design_purchases\".\"currency\" in ('UGX', 'USD')"
        },
        "design_purchases_payment_method_check": {
          "name": "design_purchases_payment_method_check",
          "value": "\n        \"design_purchases\".\"payment_method\" is null or\n        \"design_purchases\".\"payment_method\" in (\n          'mobile_money',\n          'bank_transfer',\n          'cash',\n          'other'\n        )\n      "
        },
        "design_purchases_payment_status_check": {
          "name": "design_purchases_payment_status_check",
          "value": "\n        \"design_purchases\".\"payment_status\" in (\n          'pending',\n          'submitted',\n          'confirmed',\n          'rejected'\n        )\n      "
        },
        "design_purchases_access_status_check": {
          "name": "design_purchases_access_status_check",
          "value": "\n        \"design_purchases\".\"access_status\" in (\n          'pending',\n          'active',\n          'revoked'\n        )\n      "
        }
      },
