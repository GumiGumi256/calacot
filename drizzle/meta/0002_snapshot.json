      "checkConstraints": {
        "estate_enquiries_intent_check": {
          "name": "estate_enquiries_intent_check",
          "value": "\"real_estate_enquiries\".\"intent\" in ('buy-home', 'buy-land', 'sell-property')"
        },
        "estate_enquiries_currency_check": {
          "name": "estate_enquiries_currency_check",
          "value": "\"real_estate_enquiries\".\"currency\" in ('UGX', 'USD')"
        },
        "estate_enquiries_contact_check": {
          "name": "estate_enquiries_contact_check",
          "value": "\"real_estate_enquiries\".\"contact_method\" in ('email', 'phone', 'whatsapp')"
        },
        "estate_enquiries_status_check": {
          "name": "estate_enquiries_status_check",
          "value": "\"real_estate_enquiries\".\"status\" in ('new', 'contacted', 'closed')"
        },
        "estate_enquiries_budget_check": {
          "name": "estate_enquiries_budget_check",
          "value": "(\"real_estate_enquiries\".\"budget_min\" is null or \"real_estate_enquiries\".\"budget_min\" > 0) and (\"real_estate_enquiries\".\"budget_max\" is null or \"real_estate_enquiries\".\"budget_max\" > 0) and (\"real_estate_enquiries\".\"budget_min\" is null or \"real_estate_enquiries\".\"budget_max\" is null or \"real_estate_enquiries\".\"budget_max\" >= \"real_estate_enquiries\".\"budget_min\")"
        },
        "estate_enquiries_price_check": {
          "name": "estate_enquiries_price_check",
          "value": "\"real_estate_enquiries\".\"asking_price\" is null or \"real_estate_enquiries\".\"asking_price\" > 0"
        },
        "estate_enquiries_reachable_check": {
          "name": "estate_enquiries_reachable_check",
          "value": "(\"real_estate_enquiries\".\"contact_method\" = 'email' and nullif(\"real_estate_enquiries\".\"email\", '') is not null) or (\"real_estate_enquiries\".\"contact_method\" in ('phone', 'whatsapp') and nullif(\"real_estate_enquiries\".\"phone\", '') is not null)"
        },
        "estate_enquiries_relationship_check": {
          "name": "estate_enquiries_relationship_check",
          "value": "\"real_estate_enquiries\".\"relationship\" is null or \"real_estate_enquiries\".\"relationship\" in ('owner', 'representative')"
        },
        "estate_enquiries_seller_check": {
          "name": "estate_enquiries_seller_check",
          "value": "\"real_estate_enquiries\".\"intent\" <> 'sell-property' or \"real_estate_enquiries\".\"relationship\" is not null"
        }
