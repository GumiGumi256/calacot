{
  "name": "calacot-notification-scheduler",
  "main": "worker.mjs",
  "account_id": "55d48ef7e326d2f25455491b531f4e66",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "NOTIFICATION_WORKER_URL": "https://www.calacot.com/api/notifications/worker" },
  "observability": { "enabled": true }
  // Configure NOTIFICATION_WORKER_SECRET as a Cloudflare secret.
}
